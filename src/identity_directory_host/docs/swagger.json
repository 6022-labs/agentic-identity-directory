                },
                "message": {
                    "type": "string"
                }
            }
        },
        "errors.UnavailableError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "errors.ValidationError": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "responses.AgentAddressResponse": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string"
                },
                "value": {
                    "type": "string"
                }
            }
        },
        "responses.AgentCardResponse": {
            "type": "object",
            "properties": {
                "endpoints": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "ensName": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "paymentMethods": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "protocol": {
