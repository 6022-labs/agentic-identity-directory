{
    "swagger": "2.0",
    "info": {
        "description": "Directory of the 6022 agents registered on-chain, also served over MCP at /mcp.",
        "title": "Agentic Identity Directory API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/agents": {
            "get": {
                "description": "Finds indexed 6022 agents; every field is written by the agent's owner.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Agents"
                ],
                "summary": "Search agents",
                "parameters": [
                    {
                        "type": "string",
                        "description": "words in agent names, collections and attributes",
                        "name": "query",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "exact role attribute",
                        "name": "role",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "EVM chain id",
                        "name": "chainId",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "0x collection address",
                        "name": "collectionAddress",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "0x owner address",
                        "name": "owner",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "one of the agent's own addresses",
                        "name": "address",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "true or false: has a published url",
                        "name": "published",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "page, from 1",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "1 to 100, 10 by default",
                        "name": "elementsPerPage",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.SearchAgentsResponse"
                        }
                    },
                    "400": {
                        "description": "invalid_query",
                        "schema": {
                            "$ref": "#/definitions/errors.BadRequestError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errors.InternalError"
                        }
                    }
                }
            }
        },
        "/agents/ens/{ensName}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Agents"
                ],
                "summary": "Get an agent by ENS name",
                "parameters": [
                    {
                        "type": "string",
                        "description": "e.g. my-agent.my-collection.137.6022.eth",
                        "name": "ensName",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.AgentResponse"
                        }
                    },
                    "400": {
                        "description": "invalid_path",
                        "schema": {
                            "$ref": "#/definitions/errors.BadRequestError"
                        }
                    },
                    "404": {
                        "description": "agent_not_found",
                        "schema": {
                            "$ref": "#/definitions/errors.NotFoundError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errors.InternalError"
                        }
                    }
                }
            }
        },
        "/agents/ens/{ensName}/card": {
            "get": {
                "description": "Fetches the agent's /.well-known/6022 and checks its signature against the agent's addresses.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Agents"
                ],
                "summary": "Get an agent's live card",
                "parameters": [
                    {
                        "type": "string",
                        "description": "e.g. my-agent.my-collection.137.6022.eth",
                        "name": "ensName",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.AgentCardResponse"
                        }
                    },
                    "400": {
                        "description": "invalid_path",
                        "schema": {
                            "$ref": "#/definitions/errors.BadRequestError"
                        }
                    },
                    "404": {
                        "description": "agent_not_found or agent_url_not_published",
                        "schema": {
                            "$ref": "#/definitions/errors.NotFoundError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errors.InternalError"
                        }
                    },
                    "502": {
                        "description": "the card is unreachable, invalid or wrongly signed",
                        "schema": {
                            "$ref": "#/definitions/errors.UnavailableError"
                        }
                    }
                }
            }
        },
        "/agents/{chainId}/{collectionAddress}/{tokenId}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Agents"
                ],
                "summary": "Get an agent",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "EVM chain id",
                        "name": "chainId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "0x collection address",
                        "name": "collectionAddress",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "decimal token id",
                        "name": "tokenId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.AgentResponse"
                        }
                    },
                    "400": {
                        "description": "invalid_path",
                        "schema": {
                            "$ref": "#/definitions/errors.BadRequestError"
                        }
                    },
                    "404": {
                        "description": "agent_not_found",
                        "schema": {
                            "$ref": "#/definitions/errors.NotFoundError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errors.InternalError"
                        }
                    }
                }
            }
        },
        "/collections": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Collections"
                ],
                "summary": "List agent collections",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "EVM chain id",
                        "name": "chainId",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "page, from 1",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "1 to 100, 10 by default",
                        "name": "elementsPerPage",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.ListCollectionsResponse"
                        }
                    },
                    "400": {
                        "description": "invalid_query",
                        "schema": {
                            "$ref": "#/definitions/errors.BadRequestError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errors.InternalError"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Liveness probe for the identity directory.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.GetHealthResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "errors.BadRequestError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "errors.InternalError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "errors.NotFoundError": {
            "type": "object",
            "properties": {
                "code": {
