{
  "host": {
    "api_port": 5000,
    "body_limit_bytes": 4194304,
    "listen_address": ""
  },
  "rate_limit": {
    "requests_per_second": 50
  },
  "proxy": {
    "header": "",
    "trusted_proxies": []
  },
  "database": {
    "url": "host=localhost port=5432 user=postgres password=postgres dbname=identity_directory sslmode=disable"
  },
  "migrations": {
    "folder_path": "./src/identity_directory_db/migrations"
  },
  "chains": {
    "80002": {
      "rpc_http_url": "",
      "testnet": true,
      "request_timeout_seconds": 10,
      "confirmations": 20,
      "poll_interval_seconds": 15,
      "log_window_blocks": 10000,
      "max_addresses_per_log_query": 10
    }
  },
  "agent_card": {
    "request_timeout_seconds": 10,
    "allow_private_networks": false
  },
  "telemetry": {
    "enabled": false,
    "protocol": "grpc",
    "endpoint": "localhost:4317",
    "insecure": true,
    "instance_id": "identity-directory-1",
    "environment": "local",
    "auth_token": "",
    "auth_username": "",
    "auth_password": ""
  }
}
