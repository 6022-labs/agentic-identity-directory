LOG_LEVEL=info

# HTTP host: REST API, MCP at /mcp, /health and /swagger.
HOST__API_PORT=5000
HOST__BODY_LIMIT_BYTES=4194304
# Empty binds every interface.
HOST__LISTEN_ADDRESS=

# Default: 50, per client IP.
RATE_LIMIT__REQUESTS_PER_SECOND=50
# Optional, e.g. X-Forwarded-For, or X-Real-IP when the edge adds its own hop to X-Forwarded-For; honored only
# from PROXY__TRUSTED_PROXIES.
PROXY__HEADER=
# Optional, comma-separated IPs or CIDR ranges; the Docker image trusts 127.0.0.1 + private and shared
# (100.64.0.0/10) ranges, keep 127.0.0.1 when overriding.
PROXY__TRUSTED_PROXIES=

TELEMETRY__ENABLED=false
# grpc (default) or http; endpoint stays host:port (collector 4317 for grpc, 4318 for http).
TELEMETRY__PROTOCOL=
TELEMETRY__ENDPOINT=
TELEMETRY__INSECURE=false
TELEMETRY__INSTANCE_ID=
TELEMETRY__ENVIRONMENT=
TELEMETRY__AUTH_TOKEN=
TELEMETRY__AUTH_USERNAME=
TELEMETRY__AUTH_PASSWORD=

# Postgres; migrations run at startup.
DATABASE__URL=host=localhost port=5432 user=postgres password=postgres dbname=identity_directory sslmode=disable
# Default: ./src/identity_directory_db/migrations (the Docker image sets /migrations).
MIGRATIONS__FOLDER_PATH=

# One block per chain, among the chains 6022 is deployed on (137, 80002, 31337); contracts are baked in.
CHAINS__80002__RPC_HTTP_URL=
# Required on every chain: startup refuses a mix of testnet and mainnet chains.
CHAINS__80002__TESTNET=true
CHAINS__80002__REQUEST_TIMEOUT_SECONDS=10
# Blocks the index stays behind the head, so a reorg shallower than this never reaches it.
CHAINS__80002__CONFIRMATIONS=20
CHAINS__80002__POLL_INTERVAL_SECONDS=15
# Blocks per eth_getLogs; a range the node refuses is split in halves.
CHAINS__80002__LOG_WINDOW_BLOCKS=10000
CHAINS__80002__MAX_ADDRESSES_PER_LOG_QUERY=10

# /.well-known/6022 fetches, at agent URLs anyone can publish: public addresses only, unless allowed for local work.
AGENT_CARD__REQUEST_TIMEOUT_SECONDS=10
AGENT_CARD__ALLOW_PRIVATE_NETWORKS=false
